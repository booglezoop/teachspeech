{% macro practice(s) %}{
  "@type": "LocalBusiness",
  "@id": {{ (site.url + "/specialisti/" + s.slug + "/#practice") | dump | safe }},
  "name": {{ (s.titleRole + " " + s.name) | dump | safe }},
  "url": {{ (site.url + "/specialisti/" + s.slug + "/") | dump | safe }},
  "telephone": {{ s.phoneHref | dump | safe }},
  "image": {{ (site.url + s.photo) | dump | safe }},
  "address": { "@type": "PostalAddress", "streetAddress": {{ site.streetAddress | dump | safe }}, "addressLocality": {{ site.locality | dump | safe }}, "addressCountry": {{ site.country | dump | safe }} },
  "geo": { "@type": "GeoCoordinates", "latitude": {{ site.lat }}, "longitude": {{ site.lng }} },
  "sameAs": [{{ s.facebook | dump | safe }}]
}{% endmacro %}
<script type="application/ld+json">
{"@context": "https://schema.org", "@graph": [
{% if page.url == "/" %}
{ "@type": "WebSite", "@id": {{ (site.url + "/#website") | dump | safe }}, "name": {{ site.name | dump | safe }}, "url": {{ (site.url + "/") | dump | safe }}, "inLanguage": "bg" },
{% for sp in specialists %}{{ practice(sp) }}{% if not loop.last %},{% endif %}{% endfor %}
{% elif isPost %}
{ "@type": "Article", "@id": {{ (site.url + page.url + "#article") | dump | safe }}, "headline": {{ title | dump | safe }}, "datePublished": {{ published | dump | safe }}, "inLanguage": "bg", "mainEntityOfPage": {{ (site.url + page.url) | dump | safe }} {% if authorList.length %}, "author": [{% for a in authorList %}{ "@type": "Person", "name": {{ a.name | dump | safe }}, "url": {{ (site.url + "/specialisti/" + a.slug + "/") | dump | safe }} }{% if not loop.last %},{% endif %}{% endfor %}]{% endif %} }
{% elif s %}
{{ practice(s) }}
{% else %}
{ "@type": "WebSite", "@id": {{ (site.url + "/#website") | dump | safe }}, "name": {{ site.name | dump | safe }}, "url": {{ (site.url + "/") | dump | safe }}, "inLanguage": "bg" }
{% endif %}
]}
</script>
