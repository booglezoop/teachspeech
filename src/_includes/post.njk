---
layout: base.njk
---
{% set imgs = blogImages[page.fileSlug] %}
<article class="post{% if toc %} has-toc{% endif %}{% if kind == "article" %} post-article{% endif %}"><div class="wrap">
<p><a href="/blog/">&larr; Всички статии</a></p>
<h1>{{ title }}</h1>
<p class="meta">{% for a in authorList %}<a href="/specialisti/{{ a.slug }}/">{{ a.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% if authorList.length %} · {% endif %}<time datetime="{{ published }}">{{ published | bgDate }}</time></p>
{% if showLead != false %}<p class="lead">{{ lead }}</p>{% endif %}
{% if kind != "article" %}
{% if imgs and imgs.length %}
<div class="post-pages">{% for f in imgs %}<a href="/images/blog/{{ page.fileSlug }}/{{ f }}"><img src="/images/blog/{{ page.fileSlug }}/{{ f }}" alt="{{ title }} – страница {{ loop.index }} от {{ loop.length }}"{% if loop.index > 1 %} loading="lazy"{% endif %} decoding="async" /></a>{% endfor %}</div>
{% else %}
<p><span class="ph">[снимки на брошурата – очакват се от автора]</span></p>
{% endif %}
{% endif %}
{% if toc %}<div class="post-layout"><div class="post-body">{{ content | safe }}</div>
<nav class="contents" aria-label="Съдържание на статията"><h2>В статията</h2><ol>{% for t in toc %}<li><a href="#{{ t.id }}">{{ t.label }}</a></li>{% endfor %}</ol></nav></div>
{% else %}<div class="post-body">{{ content | safe }}</div>{% endif %}
{% if closing %}<div class="post-closing{% if kind == "article" %} closing-panel{% endif %}"><p>{{ closing }}</p>{% if authorList.length %}<p><a href="/specialisti/{{ authorList[0].slug }}/"><strong>{{ authorList[0].titleRole }} {{ authorList[0].name }}</strong></a></p>{% endif %}</div>{% endif %}
</div></article>
