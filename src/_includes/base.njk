{% from "macros.njk" import v %}<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{{ title }} – Мечо Пух</title>
    <meta name="description" content="{{ description or site.defaultDescription }}" />
    <link rel="preload" href="/fonts/inter-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    {% if not site.launched or noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title }} – {{ site.name }}" />
    <meta property="og:description" content="{{ description or site.defaultDescription }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}/images/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {% include "schema.njk" %}
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <a class="skip" href="#main">Към съдържанието</a>
    <header>
      <div class="wrap">
        <a class="logo" href="/" aria-label="Мечо Пух — начало">
          <img
            src="/images/logo-mecho-puh.webp"
            alt="Мечо Пух"
            width="50"
            height="50"
          />
        </a>
        <nav aria-label="Основно меню">
          <a href="/#pomosht">С какво помагаме</a><a href="/#specialisti">Специалисти</a><a href="/uslugi/">Услуги</a><a href="/#ceni">Цени</a><a href="/#kontakti">Контакти</a>
        </nav>
        <details class="callmenu"><summary class="btn">Обади се</summary><ul>{% for s in specialists %}<li><a href="tel:{{ s.phoneHref }}"><strong>{{ s.name }}</strong><span>{{ s.phone }}</span></a></li>{% endfor %}</ul></details>
      </div>
    </header>
    <main id="main">{{ content | safe }}</main>
    <footer>
      <div class="wrap">
        <p><strong>{{ v(site.name, "Име на сайта") }}</strong><br />Адрес: {{ v(site.address, "адрес") }}<br />Работно време: {{ v(site.hours, "работно време") }}</p>
        <p>{% for s in specialists %}{{ s.name }}: <a href="tel:{{ s.phoneHref }}">{{ s.phone }}</a><br />{% endfor %}</p>
        <p><a href="/#specialisti">Към специалистите</a></p>
        <p>&copy; {{ page.date.getFullYear() }} Всички права запазени.</p>
      </div>
    </footer>
    <div class="callbar">
      <details class="callmenu up"><summary class="btn">Обади се</summary><ul>{% for s in specialists %}<li><a href="tel:{{ s.phoneHref }}"><strong>{{ s.name }}</strong><span>{{ s.phone }}</span></a></li>{% endfor %}</ul></details><a class="btn alt" href="/#kontakti">Как да стигнете</a>
    </div>
  </body>
</html>
