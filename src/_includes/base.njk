{% from "macros.njk" import v %}<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{{ title }}</title>
    <meta name="description" content="{{ description or 'Трима самостоятелни специалиста: избор по възраст и нужда, цени, първа среща и контакти.' }}" />
    <link rel="preload" href="/fonts/inter-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <a class="skip" href="#main">Към съдържанието</a>
    <header>
      <div class="wrap">
        <a class="logo" href="/" aria-label="Мечо Пух — начало">
          <img
            src="/images/logo-mecho-puh.webp"
            alt="Мечо Пух"
            width="50"
            height="50"
          />
        </a>
        <nav aria-label="Основно меню">
          <a href="/#pomosht">С какво помагаме</a><a href="/#specialisti">Специалисти</a><a href="/#ceni">Цени</a><a href="/#kontakti">Контакти</a>
        </nav>
        <a class="btn" href="tel:{{ site.phoneHref }}">Обади се</a>
      </div>
    </header>
    <main id="main">{{ content | safe }}</main>
    <footer>
      <div class="wrap">
        <p><strong>{{ v(site.name, "Име на сайта") }}</strong><br />Телефон: <a href="tel:{{ site.phoneHref }}">{{ v(site.phone, "телефон") }}</a><br />Адрес: {{ v(site.address, "адрес") }}<br />Работно време: {{ v(site.hours, "работно време") }}</p>
        <p>Всеки специалист работи самостоятелно. <a href="/#specialisti">Към специалистите</a></p>
        <p>&copy; {{ page.date.getFullYear() }} Всички права запазени.</p>
      </div>
    </footer>
    <div class="callbar">
      <a class="btn" href="tel:{{ site.phoneHref }}">Обади се</a><a class="btn alt" href="/#kontakti">Как да стигнете</a>
    </div>
  </body>
</html>
