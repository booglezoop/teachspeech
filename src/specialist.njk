---
layout: base.njk
pagination:
  data: specialists
  size: 1
  alias: s
permalink: "specialisti/{{ s.slug }}/index.html"
eleventyComputed:
  title: "{{ s.titleRole }} {{ s.name }}, Пловдив"
---
{% from "macros.njk" import v %}
<section><div class="wrap">
<p><a href="/#specialisti">&larr; Всички специалисти</a></p>
<div class="person" data-p="{{ s.n }}"><div class="profile-head" style="--c: var(--c{{ s.n }})">{% if s.photo %}<img class="face" src="{{ s.photo }}" alt="{{ s.photoAlt }}" width="140" height="140" />{% endif %}<div>
<h1>{{ v(s.name, "Име") }}</h1><p class="role">{{ v(s.role, "роля / квалификация") }}</p>
<ul class="tags">{% for a in s.areas %}<li>{{ a }}</li>{% else %}<li>{{ v("", "области на работа") }}</li>{% endfor %}</ul>
<div class="actions"><a class="btn" href="tel:{{ s.phoneHref }}">Обади се</a><a class="btn alt" href="#kvalifikacii">Образование и квалификации</a></div></div></div></div>
<div class="cols" style="margin-top:36px"><div>
{% if s.tagline %}<p><strong>{{ s.tagline }}</strong></p>{% endif %}
{% for para in s.intro %}<p>{{ para }}</p>{% else %}<p>{{ v("", "кратко представяне – с одобрение") }}</p>{% endfor %}
{% if s.help %}<h2>{{ s.helpTitle }}</h2><ul class="svc">{% for h in s.help %}<li>{{ h }}</li>{% endfor %}</ul>{% endif %}
{% for sec in s.sections %}<h2>{{ sec.title }}</h2><p>{{ sec.text }}</p>{% endfor %}
</div>
<aside class="card"><h3>Свържете се</h3><p>Телефон: <a href="tel:{{ s.phoneHref }}">{{ s.phone }}</a></p><p>Адрес: {{ site.address }}{% if s.floor %} (кабинетът е на {{ s.floor }}){% endif %}</p><p class="social">{% if s.facebook %}<a class="fb" href="{{ s.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook страница на {{ s.name }} (отваря се в нов раздел)"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg> Facebook</a>{% endif %}{% include "viberlink.njk" %}</p><p>Онлайн сесии: {{ v("", "да/не") }}</p></aside></div>
{% set mine = collections.posts | postsBy(s.slug) %}
{% if mine.length %}<div id="statii" style="margin-top:36px"><h2>Статии в блога</h2>
<ul class="postlist">{% for p in mine %}<li><a href="{{ p.url }}">{{ p.data.title }}</a><span class="postlist-meta"><span class="pills">{% for c in p.data.categoryList %}<span class="pill">{{ c }}</span>{% endfor %}</span><time datetime="{{ p.data.published }}">{{ p.data.published | bgDate }}</time></span></li>{% endfor %}</ul>
<p><a href="/blog/">Всички статии в блога &rarr;</a></p></div>{% endif %}
<div id="kvalifikacii" style="margin-top:36px"><h2>Образование</h2><ul class="svc">{% for e in s.education %}<li>{{ e }}</li>{% endfor %}</ul>
<h2>Обучения и квалификации</h2><ul class="svc">{% for t in s.trainings %}<li>{{ t }}</li>{% endfor %}</ul></div>
</div></section>
